# Required: the single shared password that gates the web UI.
TRACK_PASSWORD=change-me-to-a-long-random-string

# Optional: bearer token for the phone app's sync API (min 24 chars).
# Generate one with: python3 -c "import secrets;print(secrets.token_urlsafe(36))"
TRACK_API_TOKEN=

# Optional
TRACK_NAME=                  # shown in the greeting
TRACK_TZ=UTC                 # IANA zone used for "today", e.g. Asia/Kolkata
TRACK_DB=./data/track.db     # SQLite file location
TRACK_COOKIE_SECURE=1        # set to 1 when serving over HTTPS
TRACK_PUBLIC_URL=            # e.g. https://track.example.com when behind a proxy
