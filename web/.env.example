# Required: the single shared password that gates the web UI.
# Sign-in stays disabled (fail closed) while this is unset.
TRACK_PASSWORD=change-me-to-a-long-random-string

# Recommended: secret that signs session cookies, independent of the password,
# so changing the password does not sign everyone out. Min 32 chars.
# Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
TRACK_SESSION_SECRET=

# Optional: bump this integer to sign every browser out (default 0).
TRACK_SESSION_EPOCH=0

# Optional: "0" stops accepting sessions issued before TRACK_SESSION_SECRET
# existed (the password-derived key). Leave unset during the transition.
TRACK_LEGACY_SESSIONS=

# Optional: bearer token for the phone app's sync API (min 24 chars).
# Generate one with: python3 -c "import secrets;print(secrets.token_urlsafe(36))"
TRACK_API_TOKEN=

# Optional
TRACK_NAME=                  # shown in the greeting
TRACK_TZ=UTC                 # IANA zone used for "today", e.g. Asia/Kolkata. Set the SAME zone as TRACK_TIMEZONE
TRACK_TIMEZONE=              # IANA zone used by the calendar (defaults to Asia/Kolkata)
TRACK_FILES_DIR=./data/files # private storage for Documents attachments (never served statically)
TRACK_DB=./data/track.db     # SQLite file location
TRACK_COOKIE_SECURE=1        # set to 1 when serving over HTTPS (also inferred from TRACK_PUBLIC_URL or X-Forwarded-Proto)
TRACK_PUBLIC_URL=            # e.g. https://track.example.com when behind a proxy; https enables HSTS
GITHUB_TOKEN=               # optional: enables the read-only 'Sync from GitHub' button on /integrations

# Optional: enables the shared AI features after per-feature consent in Settings.
# The key is server-only and is never displayed or stored in SQLite.
OPENROUTER_API_KEY=
# Default: openrouter/free (OpenRouter free router). Override with any valid OpenRouter model slug.
OPENROUTER_MODEL=
# Set to 1 to block every AI request, including requests with saved consent.
TRACK_AI_DISABLED=
