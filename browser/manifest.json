{
  "manifest_version": 3,
  "name": "Track Pulse",
  "version": "0.5.0",
  "description": "Opt-in foreground browser activity for your own Track server. No URLs collected.",
  "permissions": [
    "storage",
    "alarms",
    "idle",
    "declarativeNetRequestWithHostAccess"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "incognito": "not_allowed",
  "optional_permissions": [
    "tabs"
  ],
  "minimum_chrome_version": "120"
}
